<?xml version="1.0"?>
<ices:Configuration xmlns:ices="http://www.icecast.org/projects/ices">
  <Playlist>
    <!-- Playlist script path. The command line -M overrides this. -->
    <Module>/usr/bin/icing-playlist-module.php</Module>
    <!-- Seconds to crossfade. Leave out or set to zero to disable.
         Crossfade is registered before CrossMix and MinCrossfade. -->
    <Crossfade>5</Crossfade>
    <!-- 1 keeps both tracks at full volume during the crossfade. -->
    <CrossMix>0</CrossMix>
    <!-- Minimum track length in seconds before the crossfader runs. -->
    <MinCrossfade>60</MinCrossfade>
  </Playlist>

  <Execution>
    <!-- Directory for ices70.log. -->
    <BaseDirectory>/tmp</BaseDirectory>
  </Execution>

  <Stream>
    <Server>
      <Hostname>localhost</Hostname>
      <Port>8000</Port>
      <Username>source</Username>
      <Password>letmein</Password>
      <!-- Only http is accepted. -->
      <Protocol>http</Protocol>
    </Server>

    <Mountpoint>/ices</Mountpoint>
    <Name>Default stream</Name>
    <Genre>Default genre</Genre>
    <Description>Default description</Description>
    <URL>http://localhost/</URL>
    <Public>1</Public>

    <Bitrate>128</Bitrate>
    <Samplerate>44100</Samplerate>
    <Channels>2</Channels>
  </Stream>
</ices:Configuration>
